# FREE text/story generation only. OpenRouter's free router is used; no paid model fallback.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://github.com/aibroskyee-beep
OPENROUTER_APP_NAME=AI-Broskyee AutoFactory

# YouTube upload: set up a Google OAuth desktop client and an authorized refresh token locally.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_CATEGORY_ID=28

# Instagram Creator publishing via Instagram Login API. Never put these in source code.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v26.0

# Needed for Instagram because its publishing API fetches the Reel from a public HTTPS video URL.
# The workflow can expose the final MP4 briefly as a public GitHub Release asset in a public repo.
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Never set any billing or paid fallback variables. Missing credentials => no publish.
